{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_DB_HOST;Database=YOUR_DB_NAME;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Pooling=true"
  },
  "JwtSettings": {
    "Secret": "YOUR_JWT_SECRET_KEY_MIN_32_CHARS_LONG",
    "Issuer": "BarcodeShippingSystem",
    "Audience": "BarcodeShippingSystemClient",
    "ExpirationMinutes": 480
  },
  "EncryptionSettings": {
    "Key": "YOUR_ENCRYPTION_KEY"
  },
  "AllowedHosts": "*"
}